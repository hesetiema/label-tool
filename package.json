{
  "name": "label-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hesetiema/label-tool.git"
  },
  "description": "A learning-oriented 3D point cloud annotation tool built with Vue3 + TS + Three.js, inspired by SUSTechPOINTS",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm check:layers && pnpm test:core && pnpm test:domain && pnpm test:studio && pnpm test:p0 && pnpm test:p2 && pnpm test:p3",
    "check:layers": "node scripts/check-layers.mjs",
    "test:core": "esbuild tests/core-check.ts --bundle --platform=node --format=esm --outfile=tests/.check.bundle.mjs && node tests/.check.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.check.bundle.mjs',{force:true})\"",
    "test:domain": "esbuild tests/domain-check.ts --bundle --platform=node --format=esm --outfile=tests/.domain.bundle.mjs && node tests/.domain.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.domain.bundle.mjs',{force:true})\"",
    "test:studio": "esbuild tests/studio-check.ts --bundle --platform=node --format=esm --outfile=tests/.studio.bundle.mjs && node tests/.studio.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.studio.bundle.mjs',{force:true})\"",
    "test:p0": "esbuild tests/p0-check.ts --bundle --platform=node --format=esm --outfile=tests/.p0.bundle.mjs && node tests/.p0.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.p0.bundle.mjs',{force:true})\"",
    "test:p2": "esbuild tests/p2-check.ts --bundle --platform=node --format=esm --outfile=tests/.p2.bundle.mjs && node tests/.p2.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.p2.bundle.mjs',{force:true})\"",
    "test:p3": "esbuild tests/p3-check.ts --bundle --platform=node --format=esm --outfile=tests/.p3.bundle.mjs && node tests/.p3.bundle.mjs && node -e \"require('node:fs').rmSync('tests/.p3.bundle.mjs',{force:true})\"",
    "test:browser": "node scripts/browser/run.mjs"
  },
  "dependencies": {
    "three": "^0.171.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
