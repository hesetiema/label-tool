{
  "name": "label-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hesetiema/label-tool.git"
  },
  "description": "A learning-oriented 3D point cloud annotation tool built with Vue3 + TS + Three.js, inspired by SUSTechPOINTS",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm check:layers && vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:layers": "node scripts/check-layers.mjs",
    "test:browser": "node scripts/browser/run.mjs",
    "size": "size-limit",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:layers && pnpm test && pnpm build && pnpm size"
  },
  "dependencies": {
    "three": "^0.171.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.25.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.7",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "size-limit": [
    {
      "name": "主包 index（gzip）",
      "path": "dist/assets/index-*.js",
      "limit": "160 kB"
    },
    {
      "name": "three 分包（gzip，含按需引入的 OrbitControls）",
      "path": "dist/assets/three-*.js",
      "limit": "140 kB"
    },
    {
      "name": "样式（gzip）",
      "path": "dist/assets/index-*.css",
      "limit": "12 kB"
    }
  ]
}
